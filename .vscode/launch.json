{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 6008,
      "continueOnAttach": true,
      "timeout": 60000,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "Launch Extension Development Host"
    },
    {
      "name": "Attach to Extension Host (IPv4)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": "${input:extensionHostPort}",
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Attach to Language Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "outFiles": [
        "${workspaceFolder}/node_modules/sysml-v2-lsp/dist/server/**/*.js"
      ]
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/test/suite/index"
      ],
      "outFiles": [
        "${workspaceFolder}/out/test/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ],
  "inputs": [
    {
      "id": "extensionHostPort",
      "type": "promptString",
      "description": "Inspector port from the failed Extension Host connection message"
    }
  ],
  "compounds": [
    {
      "name": "Client + Server",
      "configurations": [
        "Run Extension",
        "Attach to Language Server"
      ]
    }
  ]
}
